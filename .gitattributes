# 冻结快照按字节保存，禁止 Windows 自动换行转换。
PythonVehicleSimulator/** -text
examples/** -text
run_remus.py -text
run_remus.cmd -text
requirements-lock.txt -text
docs/provenance/source_readme.md -text
# Windows 证据保留 CRLF；空白检查识别 CR 为换行，仍检查真实行尾空格。
docs/reports/evidence/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.py text eol=lf
PythonVehicleSimulator/**/*.py -text
run_remus.py -text

# 用户任务卡按附件字节保留；Markdown 两个行尾空格为原有硬换行。
docs/tasks/S1A_* -text whitespace=-blank-at-eol

# S1-B 用户任务卡同样按附件字节保留，原Markdown硬换行不改写。
docs/tasks/S1B_* -text whitespace=-blank-at-eol

# R1仅固定明确第一方文本；不改冻结来源/旧任务卡/历史证据字节。
.gitattributes text eol=lf
.github/workflows/quality.yml text eol=lf
configs/s1b.json text eol=lf
configs/s1b_r1*.json text eol=lf
docs/method_code_map.md text eol=lf
docs/schemas/S1B_gate_report.schema.json text eol=lf

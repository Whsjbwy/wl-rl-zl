{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["stage", "parent_stage", "parent_status", "task_version", "status", "base_sha", "source_commit", "run_id", "run_directory", "tested_content_sha256", "config_sha256", "environment", "commands", "checks", "artifacts", "unresolved_issues"],
  "properties": {
    "stage": {"const": "S1-A"},
    "parent_stage": {"const": "S1"},
    "parent_status": {"const": "PENDING"},
    "status": {"enum": ["PENDING", "PASS", "FAIL", "BLOCKED"]},
    "task_version": {"const": "1.0"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_commit": {"const": "c2dfbd4f4425d29bdcba98294563cda19890cdb1"},
    "tested_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment": {"type": "object", "required": ["os", "python", "device"]},
    "commands": {"type": "array", "items": {"type": "object", "required": ["name", "argv", "exit_code", "duration_s", "stdout", "stderr"], "properties": {"exit_code": {"type": "integer"}, "duration_s": {"type": "number", "minimum": 0}}}},
    "checks": {"type": "array", "items": {"type": "object", "required": ["name", "status", "details"], "properties": {"status": {"enum": ["PASS", "FAIL", "NOT_RUN"]}}}},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "unresolved_issues": {"type": "array", "items": {"type": "string"}}
  }
}
